<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP hanya diizinkan untuk proxy lokal just_audio (127.0.0.1).

  just_audio menyajikan sumber audio `StreamAudioSource` lewat server HTTP
  lokal, jadi ExoPlayer memakai jalur cleartext ke 127.0.0.1.
  Seluruh host lain tetap wajib HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
